{% extends '../layouts/case-layout.njk' %}
{% from "dynamic-content/macro.njk" import dynamicContent %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% block contentMain %}
  <a class="govuk-back-link" href="/cases">All cases</a>
  <h1 class="govuk-heading-xl">{{ data.title }}</h1>
  <p class="govuk-body">{{ data.heading }}</p>
  <table class="govuk-table">
    <caption class="govuk-visually-hidden">
      Issues with two or more active applications
    </caption>
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th class="govuk-table__header">Issue</th>
        <th class="govuk-table__header">Who</th>
        <th class="govuk-table__header">Status</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for row in data.rows %}
        <tr class="govuk-table__row">
          <td class="govuk-table__cell">
            {{ dynamicContent(row.columns.details) }}
          </td>
          <td class="govuk-table__cell">
            {{ row.assignee.name or 'Not set' }}
          </td>
          <td class="govuk-table__cell">
            {{ govukTag({ text: row.status.text, classes: row.status.classes }) }}
          </td>
        </tr>
      {% else %}
        <tr class="govuk-table__row">
          <td class="govuk-table__cell" colspan="3">No issues to review.</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
