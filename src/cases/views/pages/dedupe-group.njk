{% extends '../layouts/case-layout.njk' %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% block contentMain %}
  <a class="govuk-back-link" href="{{ data.backLink.href }}"
    >{{ data.backLink.text }}</a
  >
  <h1 class="govuk-heading-xl">{{ data.heading }}</h1>
  <p class="govuk-body">{{ data.intro }}</p>
  <form method="POST" id="{{ data.form.id }}" action="{{ data.form.action }}">
    {{ govukSelect(data.ownerField) }}
    <table class="govuk-table">
      <caption class="govuk-visually-hidden">
        Application labels
      </caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header">Case ID</th>
          <th class="govuk-table__header">Label</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for row in data.rows %}
          <tr class="govuk-table__row">
            <td class="govuk-table__cell">
              <a class="govuk-link" href="{{ row.caseLink.href }}"
                >{{ row.caseLink.text }}</a
              >{% if row.note %}
                <div class="govuk-hint">{{ row.note }}</div>
              {% endif %}
            </td>
            <td class="govuk-table__cell">{{ govukSelect(row.labelField) }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if data.saveButton %}{{ govukButton(data.saveButton) }}{% endif %}
  </form>
{% endblock %}
