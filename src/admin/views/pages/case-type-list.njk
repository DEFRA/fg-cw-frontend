{% extends "layouts/case-layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block contentMain %}
  <h1 class="govuk-heading-l">{{ pageHeading }}</h1>

  {% if data.caseTypes.rows.length > 0 %}
    {% set rows = [] %}
    {% for row in data.caseTypes.rows %}
      {% set codeHtml %}
        <a class="govuk-link" href="{{ row.code.href }}">{{ row.code.text }}</a>
      {% endset %}

      {% set statusHtml %}
        {{
          govukTag({
            text: row.status,
            classes: "govuk-tag--grey"
          })
        }}
      {% endset %}

      {%
        set tableRow = [
          { html: codeHtml },
          { text: row.name },
          { html: statusHtml }
        ]
      %}
      {% set rows = (rows.push(tableRow), rows) %}
    {% endfor %}

    {{
      govukTable({
        head: data.caseTypes.head,
        rows: rows,
        firstCellIsHeader: true
      })
    }}
  {% else %}
    <p class="govuk-body">There are no case types.</p>
  {% endif %}
{% endblock %}
